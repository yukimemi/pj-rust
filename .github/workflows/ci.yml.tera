name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

env:
  CARGO_TERM_COLOR: always
  RUST_BACKTRACE: 1

jobs:
  check:
    name: {% raw %}check (${{ matrix.os }}){% endraw %}
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@{{ vars.actions.swatinem_rust_cache }}
        with:
          # Skip cache save on PR runs — the Post step's tar.exe is
          # flaky on windows-latest (file locks under target/ make
          # the save fail and mark the otherwise-green job FAILURE,
          # blocking renovate auto-merge for downstream consumers).
          # Main keeps saving so every PR rebuild gets a warm cache.
          save-if: {% raw %}${{ github.ref == 'refs/heads/main' }}{% endraw %}
        # The GH Actions cache backend transient-flakes the restore
        # step on windows-latest just often enough to gate release
        # pipelines (verified on yukimemi/kanade@v0.6.2 — the cache
        # restore died mid-tar, killed the Windows build matrix, and
        # blocked the publish). Fall through to a cold cargo build
        # when the restore errors out: ~3–5 min slower on a single
        # job, but self-healing instead of release-blocking.
        continue-on-error: true
      - run: cargo check --all-targets

{%- if vars.PJ_RUST_TEST_RUNNER is defined and vars.PJ_RUST_TEST_RUNNER == "nextest-unit" %}

  # Opt-in runner (`PJ_RUST_TEST_RUNNER = "nextest-unit"` in `.kata/vars.toml`,
  # mirrored by the same value in the repo's Makefile.toml `[env]`). Needs a
  # `ci` profile in `.config/nextest.toml` that writes JUnit (`[profile.ci.junit]
  # path = "junit.xml"` -> target/nextest/ci/junit.xml). Test selection:
  #   lib + bin + integration: one `--profile ci` run (`-E` is one argument)
  #   examples + benches:      `cargo test`, once per OS (nextest cannot run them)
  #   doc tests:               `cargo test --doc`, guarded on src/lib.rs
  # Windows is split: test-windows-unit (lib/bin + examples/benches + doc) and
  # three integration-only shards; `test (windows-latest)` aggregates them so
  # the required check name stays stable.
  test:
    name: {% raw %}test (${{ matrix.os }}){% endraw %}
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest]
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@{{ vars.actions.swatinem_rust_cache }}
        with:
          save-if: {% raw %}${{ github.ref == 'refs/heads/main' }}{% endraw %}
        # See the check job above for why continue-on-error is set
        # on every rust-cache restore.
        continue-on-error: true
      - uses: taiki-e/install-action@v2
        with:
          tool: nextest
      - run: cargo nextest run --locked --no-tests=pass --profile ci -E 'kind(lib) | kind(bin) | kind(test)'
      - run: cargo test --locked --examples --benches
      # Doc-test step is gated on `src/lib.rs` presence: `cargo test --doc`
      # errors with `no library targets found` on bin-only crates.
      - if: {% raw %}${{ hashFiles('src/lib.rs') != '' }}{% endraw %}
        run: cargo test --locked --doc
      # Non-fatal: a flaky artifact upload must not fail a green test run.
      - if: {% raw %}${{ !cancelled() }}{% endraw %}
        uses: actions/upload-artifact@v4
        continue-on-error: true
        with:
          name: {% raw %}junit-${{ matrix.os }}{% endraw %}
          path: target/nextest/ci/junit.xml
          if-no-files-found: ignore

  test-windows-unit:
    name: test-windows-unit
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@{{ vars.actions.swatinem_rust_cache }}
        with:
          shared-key: windows-unit
          save-if: {% raw %}${{ github.ref == 'refs/heads/main' }}{% endraw %}
        continue-on-error: true
      - uses: taiki-e/install-action@v2
        with:
          tool: nextest
      - run: cargo nextest run --locked --no-tests=pass --profile ci -E 'kind(lib) | kind(bin)'
      - run: cargo test --locked --examples --benches
      - if: {% raw %}${{ hashFiles('src/lib.rs') != '' }}{% endraw %}
        run: cargo test --locked --doc
      - if: {% raw %}${{ !cancelled() }}{% endraw %}
        uses: actions/upload-artifact@v4
        continue-on-error: true
        with:
          name: junit-windows-unit
          path: target/nextest/ci/junit.xml
          if-no-files-found: ignore

  test-windows-shard:
    name: {% raw %}test-windows-shard (${{ matrix.shard }}/3){% endraw %}
    runs-on: windows-latest
    strategy:
      fail-fast: false
      matrix:
        shard: [1, 2, 3]
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@{{ vars.actions.swatinem_rust_cache }}
        with:
          shared-key: windows-shard
          save-if: {% raw %}${{ github.ref == 'refs/heads/main' }}{% endraw %}
        continue-on-error: true
      - uses: taiki-e/install-action@v2
        with:
          tool: nextest
      - run: {% raw %}cargo nextest run --locked --no-tests=pass --profile ci -E 'kind(test)' --partition count:${{ matrix.shard }}/3{% endraw %}
      - if: {% raw %}${{ !cancelled() }}{% endraw %}
        uses: actions/upload-artifact@v4
        continue-on-error: true
        with:
          name: {% raw %}junit-windows-shard-${{ matrix.shard }}{% endraw %}
          path: target/nextest/ci/junit.xml
          if-no-files-found: ignore

  # Required-check aggregate: keeps the pre-split name. Fails unless both
  # parts finished with exactly `success` (failed, cancelled and skipped all
  # fail it).
  test-windows:
    name: test (windows-latest)
    if: {% raw %}${{ always() }}{% endraw %}
    needs: [test-windows-unit, test-windows-shard]
    runs-on: ubuntu-latest
    steps:
      - env:
          UNIT: {% raw %}${{ needs.test-windows-unit.result }}{% endraw %}
          SHARD: {% raw %}${{ needs.test-windows-shard.result }}{% endraw %}
        run: |
          echo "unit=$UNIT shard=$SHARD"
          [ "$UNIT" = success ] && [ "$SHARD" = success ]
{%- else %}

  test:
    name: {% raw %}test (${{ matrix.os }}){% endraw %}
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@{{ vars.actions.swatinem_rust_cache }}
        with:
          save-if: {% raw %}${{ github.ref == 'refs/heads/main' }}{% endraw %}
        # See the check job above for why continue-on-error is set
        # on every rust-cache restore (transient GH Actions cache
        # backend flake on windows-latest).
        continue-on-error: true
      # `cargo test --all-targets` covers lib / bins / tests / benches
      # / examples but EXCLUDES doc tests, so run --doc separately.
      # Doc-test step is gated on `src/lib.rs` presence: `cargo test
      # --doc` errors with `no library targets found` on bin-only
      # crates (yukimemi/todoke#50, yukimemi/rvpm#176 track the
      # consumer-side refactor). Drop this `if:` once both land.
      - run: cargo test --all-targets
      - if: {% raw %}${{ hashFiles('src/lib.rs') != '' }}{% endraw %}
        run: cargo test --doc
{%- endif %}

  fmt:
    name: rustfmt
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt
      - run: cargo fmt --all -- --check

  editorconfig:
    # Enforces the repo's `.editorconfig` (LF, trimmed trailing
    # whitespace, per-filetype indent width) across every tracked file,
    # not just Rust sources. `cargo make check`'s `editorconfig-check`
    # task runs the same tool locally but skips gracefully when the
    # `editorconfig-checker` binary isn't on PATH (it isn't a Rust
    # crate, so `cargo install` can't fetch it) — this job is the
    # actual enforcement gate.
    name: editorconfig
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}
      - uses: editorconfig-checker/action-editorconfig-checker@{{ vars.actions.editorconfig_checker }}
      - run: editorconfig-checker

  clippy:
    # Matrix across all three OSes so OS-specific dead code (e.g. helpers
    # gated under `cfg(target_os = "windows")`) is caught everywhere, not
    # just on the maintainer's machine. Without this, a Windows-only
    # helper looks fine on a Windows pre-push hook but blows up the Linux
    # clippy run.
    name: clippy ({% raw %}${{ matrix.os }}{% endraw %})
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy
      - uses: Swatinem/rust-cache@{{ vars.actions.swatinem_rust_cache }}
        with:
          save-if: {% raw %}${{ github.ref == 'refs/heads/main' }}{% endraw %}
        # See the check job above for why continue-on-error is set
        # on every rust-cache restore (transient GH Actions cache
        # backend flake on windows-latest).
        continue-on-error: true
      - run: cargo clippy --all-targets -- -D warnings

  lockfile:
    # Catches stale Cargo.lock (e.g. version bumped in Cargo.toml but lock
    # still points at the old version) before it reaches the publish job,
    # which uses --locked and would otherwise fail there.
    name: cargo lockfile in sync
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@{{ vars.actions.swatinem_rust_cache }}
        with:
          save-if: {% raw %}${{ github.ref == 'refs/heads/main' }}{% endraw %}
        # See the check job above for why continue-on-error is set
        # on every rust-cache restore (transient GH Actions cache
        # backend flake on windows-latest).
        continue-on-error: true
      - run: cargo check --locked --all-targets

  coverage:
    # llvm-cov on Linux + Codecov upload. taiki-e/install-action grabs the
    # cargo-llvm-cov binary. codecov-action@v5 nominally accepts tokenless
    # uploads from public repos, but in practice Codecov rejects them with
    # 'Token required - not valid tokenless upload', so plumb CODECOV_TOKEN
    # through as a repo secret. `fail_ci_if_error: false` still keeps a
    # flaky upload from gating merges.
    name: coverage
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: llvm-tools-preview
      - uses: Swatinem/rust-cache@{{ vars.actions.swatinem_rust_cache }}
        with:
          save-if: {% raw %}${{ github.ref == 'refs/heads/main' }}{% endraw %}
        # See the check job above for why continue-on-error is set
        # on every rust-cache restore (transient GH Actions cache
        # backend flake on windows-latest).
        continue-on-error: true
      - uses: taiki-e/install-action@v2
        with:
          tool: cargo-llvm-cov
      - run: cargo llvm-cov --workspace --lcov --output-path lcov.info
      - uses: codecov/codecov-action@v5
        with:
          token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
          files: lcov.info
          fail_ci_if_error: false
